+        engine_id = meta.remote.engine_id
+        # Do not tear down descriptor/agent state under another request whose
+        # DMA has already been posted to the same peer.
+        for other_req_id, handles in self._recving_transfers.items():
+            if other_req_id == req_id or not handles:
