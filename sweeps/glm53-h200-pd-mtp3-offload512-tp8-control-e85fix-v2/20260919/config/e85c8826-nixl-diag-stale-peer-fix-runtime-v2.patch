+        """Drop one stale peer generation and re-handshake once per request."""
+        assert meta.remote is not None
+        if req_id in self._stale_peer_retries:
+            self._diag_event(
+                "peer.recovery_rejected",
+                req_id,
+                reason="retry_exhausted",
+                remote_engine_id=meta.remote.engine_id,
+            )
+            return False
+        # A request with a posted sibling READ cannot safely be retried because
+        # that DMA may still write into the same destination blocks.
+        if self._recving_transfers.get(req_id):
+            self._diag_event(
+                "peer.recovery_rejected",
+                req_id,
+                reason="request_dma_inflight",
+                remote_engine_id=meta.remote.engine_id,
+            )
+            return False
