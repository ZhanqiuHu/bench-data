+    def _diag_event(self, event: str, req_id: str | None = None, **fields) -> None:
+        """Emit one machine-readable PD/NIXL lifecycle record when enabled."""
+        if os.getenv("VLLM_NIXL_DIAG", "0") != "1":
+            return
+        record = {
+            "ts_wall_ns": time.time_ns(),
+            "ts_mono_ns": time.monotonic_ns(),
+            "event": event,
+            "request_id": req_id,
+            "engine_id": getattr(self, "engine_id", None),
+            "tp_rank": getattr(self, "transfer_tp_rank", None),
+            "tp_size": getattr(self, "transfer_tp_size", None),
+            "dcp_rank": getattr(self, "dcp_rank", None),
+            "dcp_size": getattr(self, "dcp_size", None),
+            "thread": threading.current_thread().name,
+            **fields,
+        }
+        logger.warning("NIXL_DIAG %s", json.dumps(record, default=str, sort_keys=True))
+
+    @staticmethod
+    def _diag_ids(value) -> dict[str, Any]:
+        def flatten(item):
+            if isinstance(item, np.ndarray):
+                yield from item.reshape(-1).tolist()
+            elif isinstance(item, (list, tuple)):
+                for child in item:
+                    yield from flatten(child)
+            else:
+                yield int(item)
+
+        array = np.asarray(list(flatten(value)), dtype=np.int64)
+        raw = array.tobytes()
+        return {
+            "count": int(array.size),
+            "first": array[:8].tolist(),
+            "last": array[-8:].tolist() if array.size else [],
+            "sha256": hashlib.sha256(raw).hexdigest(),
+        }
+
+    @staticmethod
+    def _diag_all_ids(value) -> list[int]:
+        def flatten(item):
+            if isinstance(item, np.ndarray):
+                yield from item.reshape(-1).tolist()
+            elif isinstance(item, (list, tuple)):
+                for child in item:
+                    yield from flatten(child)
+            else:
+                yield int(item)
+
+        return list(flatten(value))
+
+    @staticmethod
+    def _diag_data(value) -> dict[str, Any]:
+        data = np.asarray(value).tolist()
+        encoded = json.dumps(data, default=str, separators=(",", ":")).encode()
+        return {
+            "rows": len(data),
+            "first": data[:2],
+            "last": data[-2:] if data else [],
+            "sha256": hashlib.sha256(encoded).hexdigest(),
+        }
